{
  "name": "codex-note-helper",
  "displayName": "Codex Note Helper",
  "description": "Fill or append Markdown heading sections through a configurable Codex CLI command.",
  "version": "0.2.2",
  "publisher": "trinitrotorol",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/trinitrotorol/codex-note-helper.git"
  },
  "bugs": {
    "url": "https://github.com/trinitrotorol/codex-note-helper/issues"
  },
  "homepage": "https://github.com/trinitrotorol/codex-note-helper#readme",
  "keywords": [
    "codex",
    "markdown",
    "notes",
    "research",
    "vscode-extension"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Codex Note Helper starts an external Codex CLI process and can edit workspace files, so it is disabled in untrusted workspaces."
    }
  },
  "scripts": {
    "test": "node --test",
    "package": "vsce package --allow-missing-repository",
    "package:strict": "vsce package"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:codexNoteHelper.fillWithCodex",
    "onCommand:codexNoteHelper.listEmptyHeadings",
    "onCommand:codexNoteHelper.deleteFailureLog",
    "onCommand:codexNoteHelper.setMode",
    "onCommand:codexNoteHelper.setFillPolicy",
    "onCommand:codexNoteHelper.runSelfTest"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexNoteHelper.fillWithCodex",
        "title": "Fill/Append Headings with Codex",
        "category": "Codex Notes"
      },
      {
        "command": "codexNoteHelper.listEmptyHeadings",
        "title": "List Empty Headings",
        "category": "Codex Notes"
      },
      {
        "command": "codexNoteHelper.deleteFailureLog",
        "title": "Delete Failure Log",
        "category": "Codex Notes"
      },
      {
        "command": "codexNoteHelper.setMode",
        "title": "Set Mode",
        "category": "Codex Notes"
      },
      {
        "command": "codexNoteHelper.setFillPolicy",
        "title": "Set Fill Policy",
        "category": "Codex Notes"
      },
      {
        "command": "codexNoteHelper.runSelfTest",
        "title": "Run Self Test",
        "category": "Codex Notes"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "codexNoteHelper.fillWithCodex",
          "when": "editorLangId == markdown"
        },
        {
          "command": "codexNoteHelper.listEmptyHeadings",
          "when": "editorLangId == markdown"
        },
        {
          "command": "codexNoteHelper.deleteFailureLog"
        },
        {
          "command": "codexNoteHelper.setMode"
        },
        {
          "command": "codexNoteHelper.setFillPolicy"
        },
        {
          "command": "codexNoteHelper.runSelfTest"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codexNoteHelper.fillWithCodex",
        "key": "ctrl+k ctrl+q",
        "mac": "cmd+k cmd+q",
        "when": "editorTextFocus && editorLangId == markdown"
      }
    ],
    "configuration": {
      "title": "Codex Note Helper",
      "properties": {
        "codexNoteHelper.mode": {
          "type": "string",
          "default": "research",
          "enum": [
            "research",
            "general",
            "jobHunting"
          ],
          "description": "Prompt mode used for generated note text."
        },
        "codexNoteHelper.fillPolicy": {
          "type": "string",
          "default": "emptyOnly",
          "enum": [
            "emptyOnly",
            "emptyOrBulletsOnly",
            "appendAlways"
          ],
          "description": "Which heading sections should be updated."
        },
        "codexNoteHelper.researchField": {
          "type": "string",
          "default": "",
          "description": "Optional research field to include in the generated Codex prompt."
        },
        "codexNoteHelper.outputLanguage": {
          "type": "string",
          "default": "Japanese",
          "description": "Language to use for generated note text."
        },
        "codexNoteHelper.noteStyle": {
          "type": "string",
          "default": "",
          "description": "Optional style instruction. When empty, the selected mode supplies a default style."
        },
        "codexNoteHelper.headingLevel": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 6,
          "description": "Markdown heading level to treat as note titles."
        },
        "codexNoteHelper.codexCommand": {
          "type": "string",
          "default": "codex",
          "description": "Codex CLI executable to run. Use only an executable name or full executable path, not command-line arguments."
        },
        "codexNoteHelper.allowBundledCodexFromOpenAIExtension": {
          "type": "boolean",
          "default": false,
          "description": "Allow fallback to a bundled codex.exe from the OpenAI ChatGPT/Codex extension when codexCommand is left as codex."
        },
        "codexNoteHelper.enableWebSearch": {
          "type": "boolean",
          "default": false,
          "description": "Pass --search to Codex so it can look up paper references. Disabled by default to avoid extra network use."
        },
        "codexNoteHelper.showCodexProgress": {
          "type": "boolean",
          "default": true,
          "description": "Use Codex JSON events to show approximate progress and the current safe activity in VS Code notifications."
        },
        "codexNoteHelper.logFileName": {
          "type": "string",
          "default": "codex-note-helper.log",
          "description": "Workspace-relative log file used when the Codex command fails."
        },
        "codexNoteHelper.logLevel": {
          "type": "string",
          "default": "minimal",
          "enum": [
            "minimal",
            "debug"
          ],
          "description": "Failure log detail. Minimal avoids prompt/stdout/stderr; debug includes them for troubleshooting."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.1"
  }
}
