{
  "name": "codex-note-helper",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.3.1",
  "publisher": "trinitrotorol",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/trinitrotorol/codex-note-helper.git"
  },
  "bugs": {
    "url": "https://github.com/trinitrotorol/codex-note-helper/issues"
  },
  "homepage": "https://github.com/trinitrotorol/codex-note-helper#readme",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0b1020",
    "theme": "dark"
  },
  "pricing": "Free",
  "keywords": [
    "ai",
    "ai-notes",
    "codex",
    "codex-cli",
    "diff-review",
    "human-in-the-loop",
    "job-search",
    "japanese",
    "knowledge-management",
    "markdown",
    "markdown-notes",
    "note-generation",
    "note-taking",
    "openai",
    "research-notes",
    "study-notes",
    "technical-writing",
    "日本語",
    "研究ノート",
    "vscode-extension"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces.description%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces.description%"
    }
  },
  "scripts": {
    "test": "node --test",
    "test:vscode": "node test/vscode/run-vscode-tests.js",
    "check:syntax": "node scripts/verify.js --syntax-only",
    "verify": "node scripts/verify.js",
    "smoke:codex": "node scripts/smoke-codex.js",
    "vscode:prepublish": "npm run verify",
    "prepublishOnly": "npm run verify",
    "package": "vsce package --allow-missing-repository --no-dependencies",
    "package:strict": "vsce package --no-dependencies"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22"
  },
  "packageManager": "npm@10.9.8",
  "categories": [
    "AI",
    "Education",
    "Other"
  ],
  "main": "./extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onCommand:codexNoteHelper.listEmptyHeadings",
    "onCommand:codexNoteHelper.runSelfTest"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codexNoteHelper.fillWithCodex",
        "title": "%commands.fillWithCodex.title%",
        "category": "%commands.category%",
        "enablement": "isWorkspaceTrusted && (resourceScheme == file || resourceScheme == vscode-remote) && (editorLangId == markdown || resourceExtname == .md)"
      },
      {
        "command": "codexNoteHelper.cancelRun",
        "title": "%commands.cancelRun.title%",
        "category": "%commands.category%"
      },
      {
        "command": "codexNoteHelper.reopenPendingReview",
        "title": "%commands.reopenPendingReview.title%",
        "category": "%commands.category%",
        "icon": "$(diff)"
      },
      {
        "command": "codexNoteHelper.applyPendingReview",
        "title": "%commands.applyPendingReview.title%",
        "category": "%commands.category%",
        "icon": "$(check)"
      },
      {
        "command": "codexNoteHelper.discardPendingReview",
        "title": "%commands.discardPendingReview.title%",
        "category": "%commands.category%",
        "icon": "$(trash)"
      },
      {
        "command": "codexNoteHelper.listTargetHeadings",
        "title": "%commands.listTargetHeadings.title%",
        "category": "%commands.category%",
        "enablement": "isWorkspaceTrusted && (resourceScheme == file || resourceScheme == vscode-remote) && (editorLangId == markdown || resourceExtname == .md)"
      },
      {
        "command": "codexNoteHelper.deleteFailureLog",
        "title": "%commands.deleteFailureLog.title%",
        "category": "%commands.category%"
      },
      {
        "command": "codexNoteHelper.setMode",
        "title": "%commands.setMode.title%",
        "category": "%commands.category%"
      },
      {
        "command": "codexNoteHelper.setFillPolicy",
        "title": "%commands.setFillPolicy.title%",
        "category": "%commands.category%"
      },
      {
        "command": "codexNoteHelper.runDiagnostics",
        "title": "%commands.runDiagnostics.title%",
        "category": "%commands.category%"
      },
      {
        "command": "codexNoteHelper.chooseCliSource",
        "title": "%commands.chooseCliSource.title%",
        "category": "%commands.category%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "codexNoteHelper.fillWithCodex",
          "when": "isWorkspaceTrusted && (resourceScheme == file || resourceScheme == vscode-remote) && (editorLangId == markdown || resourceExtname == .md)"
        },
        {
          "command": "codexNoteHelper.cancelRun"
        },
        {
          "command": "codexNoteHelper.reopenPendingReview",
          "when": "codexNoteHelper.hasPendingReview"
        },
        {
          "command": "codexNoteHelper.applyPendingReview",
          "when": "codexNoteHelper.hasPendingReview"
        },
        {
          "command": "codexNoteHelper.discardPendingReview",
          "when": "codexNoteHelper.hasPendingReview"
        },
        {
          "command": "codexNoteHelper.listTargetHeadings",
          "when": "isWorkspaceTrusted && (resourceScheme == file || resourceScheme == vscode-remote) && (editorLangId == markdown || resourceExtname == .md)"
        },
        {
          "command": "codexNoteHelper.deleteFailureLog"
        },
        {
          "command": "codexNoteHelper.setMode"
        },
        {
          "command": "codexNoteHelper.setFillPolicy"
        },
        {
          "command": "codexNoteHelper.runDiagnostics"
        },
        {
          "command": "codexNoteHelper.chooseCliSource"
        }
      ],
      "editor/title": [
        {
          "command": "codexNoteHelper.applyPendingReview",
          "when": "codexNoteHelper.activeEditorHasPendingReview && resourceScheme == codex-note-helper-preview",
          "group": "navigation@1"
        },
        {
          "command": "codexNoteHelper.discardPendingReview",
          "when": "codexNoteHelper.activeEditorHasPendingReview && resourceScheme == codex-note-helper-preview",
          "group": "navigation@2"
        },
        {
          "command": "codexNoteHelper.reopenPendingReview",
          "when": "codexNoteHelper.activeEditorHasPendingReview && resourceScheme == codex-note-helper-preview",
          "group": "navigation@3"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "codexNoteHelper.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "codexNoteHelper.chooseCli",
            "title": "%walkthrough.chooseCli.title%",
            "description": "%walkthrough.chooseCli.description%",
            "media": {
              "markdown": "media/walkthrough-cli.md"
            },
            "completionEvents": [
              "onContext:codexNoteHelper.cliSourceConfigured"
            ]
          },
          {
            "id": "codexNoteHelper.runDiagnostics",
            "title": "%walkthrough.diagnostics.title%",
            "description": "%walkthrough.diagnostics.description%",
            "media": {
              "markdown": "media/walkthrough-diagnostics.md"
            },
            "completionEvents": [
              "onContext:codexNoteHelper.initialDiagnosticsPassed"
            ]
          },
          {
            "id": "codexNoteHelper.openMarkdown",
            "title": "%walkthrough.markdown.title%",
            "description": "%walkthrough.markdown.description%",
            "media": {
              "markdown": "media/walkthrough-markdown.md"
            },
            "completionEvents": [
              "onContext:editorLangId == markdown"
            ]
          },
          {
            "id": "codexNoteHelper.generateAndReview",
            "title": "%walkthrough.generate.title%",
            "description": "%walkthrough.generate.description%",
            "media": {
              "image": "media/demo.gif",
              "altText": "%walkthrough.generate.altText%"
            },
            "completionEvents": [
              "onContext:codexNoteHelper.reviewReady"
            ]
          }
        ]
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "codexNoteHelper.mode": {
          "type": "string",
          "default": "research",
          "enum": [
            "research",
            "general",
            "jobHunting"
          ],
          "enumItemLabels": [
            "%configuration.mode.label.research%",
            "%configuration.mode.label.general%",
            "%configuration.mode.label.jobHunting%"
          ],
          "enumDescriptions": [
            "%configuration.mode.enum.research%",
            "%configuration.mode.enum.general%",
            "%configuration.mode.enum.jobHunting%"
          ],
          "markdownDescription": "%configuration.mode.description%",
          "scope": "resource",
          "order": 10
        },
        "codexNoteHelper.fillPolicy": {
          "type": "string",
          "default": "emptyOnly",
          "enum": [
            "emptyOnly",
            "emptyOrBulletsOnly",
            "appendAlways"
          ],
          "enumItemLabels": [
            "%configuration.fillPolicy.label.emptyOnly%",
            "%configuration.fillPolicy.label.emptyOrBulletsOnly%",
            "%configuration.fillPolicy.label.appendAlways%"
          ],
          "enumDescriptions": [
            "%configuration.fillPolicy.enum.emptyOnly%",
            "%configuration.fillPolicy.enum.emptyOrBulletsOnly%",
            "%configuration.fillPolicy.enum.appendAlways%"
          ],
          "markdownDescription": "%configuration.fillPolicy.description%",
          "scope": "resource",
          "order": 20
        },
        "codexNoteHelper.researchField": {
          "type": "string",
          "default": "",
          "markdownDescription": "%configuration.researchField.description%",
          "scope": "resource",
          "order": 30
        },
        "codexNoteHelper.outputLanguage": {
          "type": "string",
          "default": "%configuration.outputLanguage.default%",
          "markdownDescription": "%configuration.outputLanguage.description%",
          "scope": "resource",
          "order": 40
        },
        "codexNoteHelper.noteStyle": {
          "type": "string",
          "default": "",
          "markdownDescription": "%configuration.noteStyle.description%",
          "scope": "resource",
          "order": 50
        },
        "codexNoteHelper.headingLevel": {
          "type": "integer",
          "default": 1,
          "enum": [
            1,
            2,
            3,
            4,
            5,
            6
          ],
          "enumItemLabels": [
            "H1 (#)",
            "H2 (##)",
            "H3 (###)",
            "H4 (####)",
            "H5 (#####)",
            "H6 (######)"
          ],
          "enumDescriptions": [
            "%configuration.headingLevel.enum.h1%",
            "%configuration.headingLevel.enum.h2%",
            "%configuration.headingLevel.enum.h3%",
            "%configuration.headingLevel.enum.h4%",
            "%configuration.headingLevel.enum.h5%",
            "%configuration.headingLevel.enum.h6%"
          ],
          "markdownDescription": "%configuration.headingLevel.description%",
          "scope": "resource",
          "order": 60
        },
        "codexNoteHelper.codexCommand": {
          "type": "string",
          "default": "codex",
          "markdownDescription": "%configuration.codexCommand.description%",
          "scope": "machine",
          "order": 70
        },
        "codexNoteHelper.allowBundledCodexFromOpenAIExtension": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%configuration.allowBundledCodexFromOpenAIExtension.description%",
          "scope": "machine",
          "order": 80
        },
        "codexNoteHelper.enableWebSearch": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%configuration.enableWebSearch.description%",
          "scope": "machine",
          "order": 90
        },
        "codexNoteHelper.showCodexProgress": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%configuration.showCodexProgress.description%",
          "scope": "resource",
          "order": 100
        },
        "codexNoteHelper.timeoutSeconds": {
          "type": "integer",
          "default": 300,
          "minimum": 30,
          "maximum": 1800,
          "markdownDescription": "%configuration.timeoutSeconds.description%",
          "scope": "resource",
          "order": 110
        },
        "codexNoteHelper.maxTargetHeadings": {
          "type": "integer",
          "default": 25,
          "minimum": 1,
          "maximum": 200,
          "markdownDescription": "%configuration.maxTargetHeadings.description%",
          "scope": "resource",
          "order": 120
        },
        "codexNoteHelper.maxInputCharacters": {
          "type": "integer",
          "default": 500000,
          "minimum": 1000,
          "maximum": 5000000,
          "markdownDescription": "%configuration.maxInputCharacters.description%",
          "scope": "resource",
          "order": 130
        },
        "codexNoteHelper.maxOutputBytes": {
          "type": "integer",
          "default": 1048576,
          "minimum": 65536,
          "maximum": 10485760,
          "markdownDescription": "%configuration.maxOutputBytes.description%",
          "scope": "resource",
          "order": 140
        },
        "codexNoteHelper.confirmBeforeRun": {
          "type": "string",
          "default": "appendAlways",
          "enum": [
            "always",
            "appendAlways",
            "never"
          ],
          "enumItemLabels": [
            "%configuration.confirmBeforeRun.label.always%",
            "%configuration.confirmBeforeRun.label.appendAlways%",
            "%configuration.confirmBeforeRun.label.never%"
          ],
          "enumDescriptions": [
            "%configuration.confirmBeforeRun.enum.always%",
            "%configuration.confirmBeforeRun.enum.appendAlways%",
            "%configuration.confirmBeforeRun.enum.never%"
          ],
          "markdownDescription": "%configuration.confirmBeforeRun.description%",
          "scope": "resource",
          "order": 150
        },
        "codexNoteHelper.ignoreCodexUserConfiguration": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%configuration.ignoreCodexUserConfiguration.description%",
          "scope": "machine",
          "order": 160
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "jszip": "3.10.1"
  }
}
