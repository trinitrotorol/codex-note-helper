{
  "name": "research-note-helper",
  "displayName": "Research Note Helper",
  "description": "Fill or append Markdown heading sections through a configurable Codex CLI command.",
  "version": "0.2.2",
  "publisher": "trinitrotorol",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/trinitrotorol/research-note-helper.git"
  },
  "bugs": {
    "url": "https://github.com/trinitrotorol/research-note-helper/issues"
  },
  "homepage": "https://github.com/trinitrotorol/research-note-helper#readme",
  "keywords": [
    "codex",
    "markdown",
    "notes",
    "research",
    "vscode-extension"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Research Note Helper starts an external Codex CLI process and can edit workspace files, so it is disabled in untrusted workspaces."
    }
  },
  "scripts": {
    "test": "node --test",
    "package": "vsce package --allow-missing-repository",
    "package:strict": "vsce package"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:researchNoteHelper.fillWithCodex",
    "onCommand:researchNoteHelper.listEmptyHeadings",
    "onCommand:researchNoteHelper.deleteFailureLog",
    "onCommand:researchNoteHelper.setMode",
    "onCommand:researchNoteHelper.setFillPolicy",
    "onCommand:researchNoteHelper.runSelfTest"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "researchNoteHelper.fillWithCodex",
        "title": "Fill/Append Headings with Codex",
        "category": "Research Notes"
      },
      {
        "command": "researchNoteHelper.listEmptyHeadings",
        "title": "List Empty Headings",
        "category": "Research Notes"
      },
      {
        "command": "researchNoteHelper.deleteFailureLog",
        "title": "Delete Failure Log",
        "category": "Research Notes"
      },
      {
        "command": "researchNoteHelper.setMode",
        "title": "Set Mode",
        "category": "Research Notes"
      },
      {
        "command": "researchNoteHelper.setFillPolicy",
        "title": "Set Fill Policy",
        "category": "Research Notes"
      },
      {
        "command": "researchNoteHelper.runSelfTest",
        "title": "Run Self Test",
        "category": "Research Notes"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "researchNoteHelper.fillWithCodex",
          "when": "editorLangId == markdown"
        },
        {
          "command": "researchNoteHelper.listEmptyHeadings",
          "when": "editorLangId == markdown"
        },
        {
          "command": "researchNoteHelper.deleteFailureLog"
        },
        {
          "command": "researchNoteHelper.setMode"
        },
        {
          "command": "researchNoteHelper.setFillPolicy"
        },
        {
          "command": "researchNoteHelper.runSelfTest"
        }
      ]
    },
    "keybindings": [
      {
        "command": "researchNoteHelper.fillWithCodex",
        "key": "ctrl+k ctrl+q",
        "mac": "cmd+k cmd+q",
        "when": "editorTextFocus && editorLangId == markdown"
      }
    ],
    "configuration": {
      "title": "Research Note Helper",
      "properties": {
        "researchNoteHelper.mode": {
          "type": "string",
          "default": "research",
          "enum": [
            "research",
            "general",
            "jobHunting"
          ],
          "description": "Prompt mode used for generated note text."
        },
        "researchNoteHelper.fillPolicy": {
          "type": "string",
          "default": "emptyOnly",
          "enum": [
            "emptyOnly",
            "emptyOrBulletsOnly",
            "appendAlways"
          ],
          "description": "Which heading sections should be updated."
        },
        "researchNoteHelper.researchField": {
          "type": "string",
          "default": "",
          "description": "Optional research field to include in the generated Codex prompt."
        },
        "researchNoteHelper.outputLanguage": {
          "type": "string",
          "default": "Japanese",
          "description": "Language to use for generated note text."
        },
        "researchNoteHelper.noteStyle": {
          "type": "string",
          "default": "",
          "description": "Optional style instruction. When empty, the selected mode supplies a default style."
        },
        "researchNoteHelper.headingLevel": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 6,
          "description": "Markdown heading level to treat as note titles."
        },
        "researchNoteHelper.codexCommand": {
          "type": "string",
          "default": "codex",
          "description": "Codex CLI executable to run. Use only an executable name or full executable path, not command-line arguments."
        },
        "researchNoteHelper.allowBundledCodexFromOpenAIExtension": {
          "type": "boolean",
          "default": false,
          "description": "Allow fallback to a bundled codex.exe from the OpenAI ChatGPT/Codex extension when codexCommand is left as codex."
        },
        "researchNoteHelper.enableWebSearch": {
          "type": "boolean",
          "default": false,
          "description": "Pass --search to Codex so it can look up paper references. Disabled by default to avoid extra network use."
        },
        "researchNoteHelper.showCodexProgress": {
          "type": "boolean",
          "default": true,
          "description": "Use Codex JSON events to show approximate progress and the current safe activity in VS Code notifications."
        },
        "researchNoteHelper.logFileName": {
          "type": "string",
          "default": "research-note-helper.log",
          "description": "Workspace-relative log file used when the Codex command fails."
        },
        "researchNoteHelper.logLevel": {
          "type": "string",
          "default": "minimal",
          "enum": [
            "minimal",
            "debug"
          ],
          "description": "Failure log detail. Minimal avoids prompt/stdout/stderr; debug includes them for troubleshooting."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.1"
  }
}
